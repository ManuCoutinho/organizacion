{
  "name": "organizacion",
  "private": true,
  "version": "2.0.0",
  "author": "Emanuela Coutinho",
  "license": "MIT License",
  "description": "Monorepo fullstack para gerenciamento de usuarios com API REST, JWT e RBAC",
  "repository": {
    "type": "git",
    "url": "https://github.com/ManuCoutinho/vite-react-ts-template"
  },
  "keywords": [
    "monorepo",
    "express",
    "react",
    "typescript",
    "jwt",
    "rbac"
  ],
  "engines": {
    "node": ">=22.x",
    "npm": ">=10.x"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run build --workspace @organizacion/shared && concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @organizacion/api",
    "dev:web": "npm run dev --workspace @organizacion/web",
    "build": "npm run build --workspace @organizacion/shared && npm run build --workspace @organizacion/api && npm run build --workspace @organizacion/web",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "lint": "eslint .",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down -v",
    "prepare": "husky",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\"",
    "typecheck": "tsc -b packages/shared && tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "clean": "rm -rf apps/*/dist packages/*/dist apps/*/coverage **/*.tsbuildinfo"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.48.1"
  }
}
