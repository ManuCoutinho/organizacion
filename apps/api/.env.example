NODE_ENV=development
PORT=3333

DATABASE_FILE=./data/organizacion.db

JWT_SECRET=troque-este-valor-por-um-segredo-de-no-minimo-32-caracteres
JWT_ISSUER=organizacion-api
JWT_AUDIENCE=organizacion-web
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=7

BCRYPT_ROUNDS=12
# Fora de producao, origens de loopback (localhost, 127.0.0.1, ::1) sao aceitas
# em qualquer porta. Em producao vale apenas esta lista.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

SEED_ADMIN_EMAIL=admin@organizacion.dev
SEED_ADMIN_PASSWORD=Admin@12345

LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
